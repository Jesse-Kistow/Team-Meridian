# Copy this file to .env.local (and to .env, which Prisma's CLI reads) and fill in real values.
# NEVER commit real secrets. Share real values privately with your teammate.

# Neon Postgres: use the DIRECT connection string (host has no "-pooler")
DATABASE_URL=

# Session/auth secret. Generate a random 32+ character string
AUTH_SECRET=

# Stripe (TEST mode keys only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

#clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up