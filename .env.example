# Copy this file to .env.local (and to .env, which Prisma's CLI reads) and fill in real values.
# NEVER commit real secrets. Share real values privately with your teammate.

# Neon Postgres: use the DIRECT connection string (host has no "-pooler")
DATABASE_URL=

# Session/auth secret. Generate a random 32+ character string
AUTH_SECRET=

# Stripe (TEST mode keys only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

# --- Seed script (personal Neon branches ONLY, never main) ---
# Set SEED_ALLOW=true only in your own local .env, never in Vercel or CI.
SEED_ALLOW=
# Emails of real test accounts you signed in with on YOUR branch
SEED_ATTENDEE_EMAIL=
SEED_ORGANIZER_EMAIL=
